    <footer class="site-footer">
      <div class="container footer-row">
        <div>
          <p class="footer-title">ERP Search</p>
          <p>Independent ERP buyer education and partner-fit guidance for small and medium businesses.</p>
        </div>
        <p>
          <a href="/guides/">Guides</a> · <a href="/compare/">Compare</a> · <a href="/blog/">Blog</a> ·
          <a href="/about/">About</a> ·
          <a href="/privacy/">Privacy</a> · <a href="/disclosure/">Disclosure</a>
        </p>
      </div>
    </footer>
    <script is:inline>
        (() => {
          const desktopQuery = window.matchMedia('(min-width: 901px)');
          const header = document.querySelector('.site-header');
          const mobileToggle = document.querySelector('.mobile-nav-toggle');
          const menus = Array.from(document.querySelectorAll('.nav-menu'));
          if (!menus.length || !header) return;
          const closeTimers = new WeakMap();

          const clearCloseTimer = (menu) => {
            const timer = closeTimers.get(menu);
            if (!timer) return;
            window.clearTimeout(timer);
            closeTimers.delete(menu);
          };

          const openMenu = (menu) => {
            clearCloseTimer(menu);
            closeMenus(menu);
            menu.classList.add('is-open');
            menu.querySelector('.nav-menu-trigger')?.setAttribute('aria-expanded', 'true');
          };

          const closeMenus = (except) => {
            menus.forEach((menu) => {
              if (menu === except) return;
              clearCloseTimer(menu);
              menu.classList.remove('is-open');
              menu.querySelector('.nav-menu-trigger')?.setAttribute('aria-expanded', 'false');
            });
          };

          menus.forEach((menu) => {
            const trigger = menu.querySelector('.nav-menu-trigger');

            trigger?.addEventListener('click', (event) => {
              event.preventDefault();
              if (desktopQuery.matches) {
                closeMenus();
                trigger.blur();
                return;
              }

              const willOpen = !menu.classList.contains('is-open');
              closeMenus(menu);
              menu.classList.toggle('is-open', willOpen);
              trigger.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
            });

            menu.addEventListener('pointerenter', () => {
              if (desktopQuery.matches) openMenu(menu);
            });

            menu.addEventListener('pointerleave', () => {
              if (!desktopQuery.matches) return;
              clearCloseTimer(menu);
              closeTimers.set(
                menu,
                window.setTimeout(() => {
                  menu.classList.remove('is-open');
                  trigger?.setAttribute('aria-expanded', 'false');
                  closeTimers.delete(menu);
                }, 280)
              );
            });
          });

          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
              closeMenus();
              header.classList.remove('is-mobile-open');
              mobileToggle?.setAttribute('aria-expanded', 'false');
            }
          });

          mobileToggle?.addEventListener('click', () => {
            if (desktopQuery.matches) return;
            const willOpen = !header.classList.contains('is-mobile-open');
            header.classList.toggle('is-mobile-open', willOpen);
            mobileToggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
            if (!willOpen) closeMenus();
          });

          desktopQuery.addEventListener?.('change', () => {
            closeMenus();
            header.classList.remove('is-mobile-open');
            mobileToggle?.setAttribute('aria-expanded', 'false');
          });
          closeMenus();
        })();
    </script>
    <script is:inline>
        (() => {
          const root = document.querySelector('[data-site-search]');
          if (!root) return;

          const input = root.querySelector('[data-search-input]');
          const results = root.querySelector('[data-search-results]');
          if (!input || !results) return;

          let index = [];
          let loaded = false;
          let loading = false;
          let activeIndex = -1;

          const getHits = () => Array.from(results.querySelectorAll('.site-search-hit'));

          const updateActiveHit = () => {
            const hits = getHits();
            hits.forEach((hit, index) => {
              const isActive = index === activeIndex;
              hit.classList.toggle('is-active', isActive);
              hit.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });
          };

          const resetActiveHit = () => {
            activeIndex = -1;
            updateActiveHit();
          };

          const formatDate = (value) => {
            try {
              return new Date(value).toLocaleDateString('en-AU', {
                day: '2-digit',
                month: 'short',
                year: 'numeric',
              }).replace(/\s/g, '-');
            } catch {
              return '';
            }
          };

          const escapeHtml = (value) =>
            String(value || '')
              .replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;')
              .replace(/'/g, '&#39;');

          const scoreItem = (item, query) => {
            const title = item.title.toLowerCase();
            const text = item.searchableText.toLowerCase();
            let score = 0;
            if (title.includes(query)) score += 8;
            if (text.includes(query)) score += 4;
            for (const term of query.split(/\s+/)) {
              if (!term) continue;
              if (title.includes(term)) score += 3;
              if (text.includes(term)) score += 1;
            }
            return score;
          };

          const renderResults = (items, query) => {
            if (!query.trim()) {
              results.hidden = true;
              results.innerHTML = '';
              resetActiveHit();
              return;
            }

            if (!items.length) {
              results.hidden = false;
              results.innerHTML = '<p class="site-search-empty">No matching content yet.</p>';
              resetActiveHit();
              return;
            }

            results.hidden = false;
            results.innerHTML = items
              .map((item) => {
                const meta = [item.section, item.kind, item.readTime + ' min read', formatDate(item.publishedAt)].filter(Boolean).join(' · ');
                return `
                  <a class="site-search-hit" href="${item.href}" aria-selected="false">
                    <span class="site-search-hit-section">${escapeHtml(item.section)}</span>
                    <strong>${escapeHtml(item.title)}</strong>
                    <span class="site-search-hit-meta">${escapeHtml(meta)}</span>
                    <span class="site-search-hit-excerpt">${escapeHtml(item.excerpt)}</span>
                  </a>
                `;
              })
              .join('');
            resetActiveHit();
          };

          const loadIndex = async () => {
            if (loaded || loading) return;
            loading = true;
            try {
              const response = await fetch('/search-index.json');
              if (!response.ok) return;
              index = await response.json();
              loaded = true;
            } catch {}
            loading = false;
          };

          input.addEventListener('focus', () => {
            loadIndex();
          });

          input.addEventListener('input', async (event) => {
            const query = event.target.value.trim().toLowerCase();
            await loadIndex();
            const matches = index
              .map((item) => ({item, score: scoreItem(item, query)}))
              .filter((entry) => entry.score > 0)
              .sort((a, b) => b.score - a.score)
              .slice(0, 8)
              .map((entry) => entry.item);
            renderResults(matches, query);
          });

          document.addEventListener('click', (event) => {
            if (!root.contains(event.target)) {
              results.hidden = true;
              resetActiveHit();
            }
          });

          input.addEventListener('keydown', (event) => {
            const hits = getHits();

            if (event.key === 'ArrowDown' && hits.length) {
              event.preventDefault();
              activeIndex = activeIndex < hits.length - 1 ? activeIndex + 1 : 0;
              updateActiveHit();
              hits[activeIndex].scrollIntoView({block: 'nearest'});
              return;
            }

            if (event.key === 'ArrowUp' && hits.length) {
              event.preventDefault();
              activeIndex = activeIndex > 0 ? activeIndex - 1 : hits.length - 1;
              updateActiveHit();
              hits[activeIndex].scrollIntoView({block: 'nearest'});
              return;
            }

            if (event.key === 'Enter' && hits.length) {
              event.preventDefault();
              const targetIndex = activeIndex >= 0 ? activeIndex : 0;
              const href = hits[targetIndex].getAttribute('href');
              if (href) {
                window.location.href = href;
              }
              return;
            }

            if (event.key === 'Escape') {
              results.hidden = true;
              resetActiveHit();
              input.blur();
            }
          });
        })();
    </script>
  </body>
</html>
