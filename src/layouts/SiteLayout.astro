            <div class="mega-menu compact-menu">
              <section class="mega-menu-column" aria-labelledby="menu-comparisons">
                <h3 id="menu-comparisons">Product Comparisons</h3>
                <a href="/compare/business-central-vs-netsuite-growing-businesses/">Business Central vs NetSuite</a>
                <a href="/compare/odoo-vs-business-central/">Odoo vs Business Central</a>
                <a href="/compare/wiise-vs-business-central-australian-smbs/">Wiise vs Business Central</a>
                <a href="/compare/myob-acumatica-vs-business-central/">MYOB Acumatica vs Business Central</a>
                <a href="/compare/business-central-vs-sap-business-one-fit-analysis/">Business Central vs SAP Business One</a>
