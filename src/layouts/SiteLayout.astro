              </section>
            </div>
          </div>
          <div class="nav-menu">
            <button class="nav-menu-trigger" type="button" aria-expanded="false">Industries</button>
            <div class="mega-menu compact-menu">
              <section class="mega-menu-column" aria-labelledby="menu-industries">
                <h3 id="menu-industries">Industry Fit</h3>
